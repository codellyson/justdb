---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Social share image — resolved to an absolute URL against `site`. */
  ogImage?: string;
  /** open-graph type — 'website' for pages, 'article' for guides. */
  ogType?: 'website' | 'article';
  /** Keep the page out of search indexes (e.g. thin utility routes). */
  noindex?: boolean;
  /** Inline JSON-LD object — stringified into a <script type="application/ld+json"> tag. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'JustDB — Simple Database Client for Developers',
  description = 'JustDB is a simple database client for developers. Browse, query and edit PostgreSQL, SQLite and Turso databases from a small desktop app — free, no signup, connecting straight from your machine.',
  ogImage = '/og-image.png',
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta name="keywords" content="PostgreSQL, SQLite, Turso, libSQL, database client, database explorer, SQL query tool, database browser, desktop database client, local database viewer" />
    <meta name="author" content="KreativeKorna Concepts" />
    <meta name="category" content="database" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="JustDB" />

    <!-- Matches the Tauri window's backgroundColor so the browser chrome, the
         page and the app all sit on the same near-black. -->
    <meta name="theme-color" content="#161412" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="JustDB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="JustDB browsing a database — table list, rows, and query editor" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    )}

    <!-- Scroll-reveal starts elements at opacity 0 and a script fades them in.
         Without JS that would leave a blank page, so undo it up-front. -->
    <noscript>
      <style>
        [data-reveal] { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </head>
  <body>
    <slot />
  </body>
</html>
