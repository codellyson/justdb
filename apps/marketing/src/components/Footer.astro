---
import { DOCS_URL, ISSUES_URL, LAUNCH_URL, ORG_URL, RELEASES_URL, REPO_URL } from '../lib/site';

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const p = (hash: string) => (home ? hash : `/${hash}`);

const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Open JustDB', href: LAUNCH_URL },
      { label: 'Download', href: RELEASES_URL, external: true },
      { label: 'Features', href: p('#features') },
      { label: 'Changelog', href: '/changelog' },
    ],
  },
  {
    title: 'Compare & learn',
    links: [
      { label: 'Use cases', href: '/alternatives' },
      { label: 'Compare', href: '/compare' },
      { label: 'Guides', href: '/guides' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Documentation', href: DOCS_URL, external: true },
      { label: 'GitHub', href: REPO_URL, external: true },
      { label: 'Issues', href: ISSUES_URL, external: true },
      { label: 'Report a bug', href: `${ISSUES_URL}/new`, external: true },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'KreativeKorna', href: ORG_URL, external: true },
      { label: 'Contact', href: `${ISSUES_URL}/new`, external: true },
    ],
  },
];
---

<footer class="border-t border-border">
  <div class="mx-auto max-w-shell px-5 py-14 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight text-primary">
          <img src="/logo.svg" alt="" width="24" height="24" class="rounded-[5px]" aria-hidden="true" />
          <span>JustDB</span>
        </a>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">
          Your database, without the database drama.
        </p>
      </div>

      {columns.map(({ title, links }) => (
        <div>
          <h3 class="mb-3 text-[11px] font-medium uppercase tracking-[0.1em] text-muted">{title}</h3>
          <ul class="space-y-2.5">
            {links.map(({ label, href, external }) => (
              <li>
                <a
                  href={href}
                  class="text-sm text-secondary transition-colors hover:text-primary"
                  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-border pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 KreativeKorna Concepts</p>
      <p class="font-mono">Free · No signup · Local-first</p>
    </div>
  </div>
</footer>
