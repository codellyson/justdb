---
import { LAUNCH_URL, REPO_URL } from '../lib/site';
interface Props { home?: boolean; }
const { home = false } = Astro.props;
---
<div class="site-nav-wrap">
  <nav class="site-nav" aria-label="Main">
    <a class="site-brand" href="/" aria-label="JustDB home"><img src="/logo.svg" alt="" width="28" height="28" /><span>just<strong>db</strong></span></a>
    <div class="site-links"><a href={home ? '#features' : '/#features'}>Features</a><a href="/blog" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>Blog</a><a href={REPO_URL}>GitHub ↗</a></div>
    <div class="site-actions">
      <button id="theme-toggle" type="button" aria-label="Switch to light theme" aria-pressed="false" title="Toggle light/dark">☼</button>
      <a class="site-open" href={LAUNCH_URL} title="Launch JustDB — requires the desktop app to be installed">Launch installed app</a>
    </div>
  </nav>
</div>
<style>
  .site-nav-wrap { position:sticky; top:0; z-index:50; background:rgb(var(--bg)); border-bottom:1px solid rgb(var(--border)); color:rgb(var(--text-primary)); }
  .site-nav { display:flex; align-items:center; gap:40px; height:64px; width:100%; max-width:1248px; margin-inline:auto; padding-inline:24px; }
  .site-brand,.site-actions,.site-links { display:flex; align-items:center; gap:12px; }
  .site-brand { font-size:18px; text-decoration:none; flex-shrink:0; }
  .site-brand strong { font-weight:600; }.site-brand img { border-radius:4px; }
  .site-links { gap:26px; font-size:13px; color:rgb(var(--text-secondary)); }
  .site-links a:hover,.site-links a[aria-current] { color:rgb(var(--text-primary)); }
  .site-actions { margin-left:auto; }
  .site-actions button { width:36px; height:36px; border:1px solid rgb(var(--border)); border-radius:6px; font-size:22px; color:rgb(var(--text-secondary)); }
  .site-actions button:hover { background:rgb(var(--bg-elevated)); }
  .site-open { display:inline-flex; justify-content:center; align-items:center; min-height:34px; padding:7px 13px; border:1px solid rgb(var(--accent)); border-radius:6px; background:rgb(var(--accent)); color:rgb(var(--accent-text)); font-size:13px; font-weight:500; text-decoration:none; white-space:nowrap; }
  .site-open:hover { background:rgb(var(--accent-hover)); }
  @media(max-width:760px) { .site-nav { gap:20px; }.site-links { gap:16px; }.site-links a:last-child { display:none; } }
  @media(max-width:480px) { .site-links { display:none; }.site-nav { gap:12px; padding-inline:16px; }.site-actions { gap:8px; } }
</style>
<script>
  const toggle = document.getElementById('theme-toggle');
  const applyTheme = (light: boolean) => {
    document.documentElement.dataset.theme = light ? 'light' : 'dark';
    const landing = document.getElementById('landing');
    if (landing) landing.dataset.theme = light ? 'light' : 'dark';
    toggle?.setAttribute('aria-pressed', String(light));
    toggle?.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
  };
  let light = false;
  try { light = localStorage.getItem('justdb-site-theme') === 'light'; } catch {}
  applyTheme(light);
  toggle?.addEventListener('click', () => {
    light = document.documentElement.dataset.theme !== 'light';
    applyTheme(light);
    try { localStorage.setItem('justdb-site-theme', light ? 'light' : 'dark'); } catch {}
  });
</script>
