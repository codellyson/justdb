---
import Button from './Button.astro';
import { LAUNCH_URL, REPO_URL, RELEASES_URL } from '../lib/site';

interface Props {
  /** Anchors only resolve on the landing page; other pages link back to it. */
  home?: boolean;
}
const { home = false } = Astro.props;
const p = (hash: string) => (home ? hash : `/${hash}`);

const links = [
  { label: 'Features', href: p('#features') },
  { label: 'Compare', href: '/compare' },
  { label: 'Guides', href: '/guides' },
  { label: 'FAQ', href: p('#faq') },
];
---

<header
  id="site-nav"
  class="sticky top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-300"
>
  <nav class="mx-auto flex h-16 max-w-shell items-center gap-6 px-5 sm:px-8" aria-label="Main">
    <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight text-primary">
      <img src="/logo.svg" alt="" width="26" height="26" class="rounded-[5px]" aria-hidden="true" />
      <span class="text-[15px]">JustDB</span>
    </a>

    <ul class="ml-4 hidden items-center gap-1 md:flex">
      {links.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="rounded-md px-3 py-2 text-sm text-secondary transition-colors hover:bg-bg-secondary hover:text-primary"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <div class="ml-auto flex items-center gap-2">
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-md px-3 py-2 text-sm text-secondary transition-colors hover:bg-bg-secondary hover:text-primary sm:inline-flex"
      >
        GitHub
      </a>
      <Button href={LAUNCH_URL} id="nav-open-app" data-fallback={RELEASES_URL} class="hidden sm:inline-flex">
        Open JustDB
      </Button>

      <button
        type="button"
        id="nav-toggle"
        class="-mr-2 inline-flex h-10 w-10 items-center justify-center rounded-md text-secondary transition-colors hover:bg-bg-secondary hover:text-primary md:hidden"
        aria-label="Open menu"
        aria-controls="nav-menu"
        aria-expanded="false"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="nav-menu"
    hidden
    class="border-t border-border bg-bg/95 backdrop-blur-xl md:hidden"
  >
    <ul class="mx-auto flex max-w-shell flex-col gap-1 px-5 py-4 sm:px-8">
      {[...links, { label: 'GitHub', href: REPO_URL }].map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="block rounded-md px-3 py-2.5 text-[15px] text-secondary transition-colors hover:bg-bg-secondary hover:text-primary"
          >
            {label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <Button href={LAUNCH_URL} class="w-full" data-fallback={RELEASES_URL}>Open JustDB</Button>
      </li>
    </ul>
  </div>
</header>

<script>
  const nav = document.getElementById('site-nav');
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');

  // Transparent over the hero, frosted once the page moves — a hard border at
  // scrollTop 0 cuts the hero in half.
  const solid = ['bg-bg/80', 'backdrop-blur-xl', 'border-border'];
  const onScroll = () => {
    nav?.classList.toggle('border-transparent', window.scrollY <= 8);
    solid.forEach((c) => nav?.classList.toggle(c, window.scrollY > 8));
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!menu || !toggle) return;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  toggle?.addEventListener('click', () => setOpen(menu?.hidden ?? true));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
