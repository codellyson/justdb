---
// Renders as <a> when `href` is provided, otherwise <button>.
type Variant = 'primary' | 'secondary' | 'ghost';
type Size = 'md' | 'lg';

interface Props {
  variant?: Variant;
  size?: Size;
  href?: string;
  external?: boolean;
  class?: string;
  id?: string;
  // Anything else (e.g. data-* attributes) is forwarded to the rendered
  // element, including descriptive titles and accessibility attributes.
  [key: `data-${string}`]: string | undefined;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  external = false,
  class: className = '',
  id,
  ...rest
} = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-2 font-medium rounded-lg whitespace-nowrap transition-[background-color,border-color,color,transform,box-shadow] duration-200 active:translate-y-px';

const sizes: Record<Size, string> = {
  md: 'px-4 py-2.5 text-sm',
  lg: 'px-6 py-3.5 text-[15px]',
};

const variants: Record<Variant, string> = {
  primary:
    'bg-accent text-accent-text hover:bg-accent-hover shadow-[0_1px_0_0_rgb(255_255_255/0.15)_inset,0_8px_24px_-12px_rgb(var(--accent)/0.7)]',
  secondary:
    'border border-border-strong bg-bg-secondary/60 text-primary hover:bg-bg-elevated hover:border-muted',
  ghost: 'text-secondary hover:text-primary hover:bg-bg-secondary',
};

const classes = `${base} ${sizes[size]} ${variants[variant]} ${className}`.trim();
---

{href ? (
  <a
    href={href}
    class={classes}
    id={id}
    {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
    {...rest}
  >
    <slot />
  </a>
) : (
  <button type="button" class={classes} id={id} {...rest}>
    <slot />
  </button>
)}
