---
import Nav from '../components/Nav.astro';
import Layout from '../layouts/Layout.astro';
import { RELEASES_URL, REPO, REPO_URL } from '../lib/site';
import { organizationJsonLd, softwareApplicationJsonLd, websiteJsonLd } from '../lib/seo';
const downloadUrl = RELEASES_URL;

// Resolve direct installer URLs for the latest release at build time so the
// device-detected CTA links straight to the right file. Asset names carry the
// version (e.g. JustDB_0.2.3_x64-setup.exe), so we can't hardcode them — we
// match by extension against the latest release. Any failure or missing asset
// falls back to the releases page.
async function resolveDownloads(): Promise<Record<'macos' | 'windows' | 'linux', string>> {
  const fallback = { macos: downloadUrl, windows: downloadUrl, linux: downloadUrl };
  try {
    const res = await fetch(`https://api.github.com/repos/${REPO}/releases/latest`, {
      headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'justdb-marketing' },
    });
    if (!res.ok) return fallback;
    const { assets = [] } = (await res.json()) as {
      assets?: { name: string; browser_download_url: string }[];
    };
    const find = (re: RegExp) => assets.find((a) => re.test(a.name))?.browser_download_url;
    return {
      macos: find(/\.dmg$/i) ?? downloadUrl,
      // NSIS setup is the standard user installer; .msi is the fallback.
      windows: find(/-setup\.exe$/i) ?? find(/\.msi$/i) ?? downloadUrl,
      // Linux bundles aren't published — send them to the releases page.
      linux: downloadUrl,
    };
  } catch {
    return fallback;
  }
}
const downloads = await resolveDownloads();

---

<Layout title="JustDB — PostgreSQL, SQLite & Turso Desktop Client" description="Browse, query, and edit PostgreSQL, SQLite, and Turso databases. A free desktop client for macOS and Windows, with no account required." jsonLd={[organizationJsonLd, websiteJsonLd, softwareApplicationJsonLd()]}>
  <div class="landing" id="landing" data-theme="dark">
    <Nav home />

    <main>
      <header class="hero">
        <h1>Just your data.<br /><span class="accent">No bullshit.</span></h1>
        <p class="intro">Browse PostgreSQL, SQLite, and Turso. Run SQL, follow relationships, and review edits before saving — all from your desktop.</p>
        <div class="hero-actions">
          <a class="button" id="cta-download" href={downloadUrl} data-download-macos={downloads.macos} data-download-windows={downloads.windows} data-download-linux={downloads.linux}>Download JustDB</a>
        </div>
        <p class="availability">Free · macOS & Windows · No account needed</p>
        <div class="brew-install">
          <span class="brew-label">Or install with Homebrew on macOS</span>
          <div class="brew-command"><code id="brew-command">brew install --cask codellyson/tap/justdb</code><button id="copy-brew" type="button" aria-label="Copy Homebrew install command">Copy</button></div>
          <span id="brew-feedback" role="status" class="brew-feedback"></span>
        </div>
      </header>

      <section class="product-overview shell" aria-label="The JustDB workspace">
        <div class="compatibility"><div>PostgreSQL <i aria-hidden="true">/</i> SQLite <i aria-hidden="true">/</i> Turso</div></div>
        <figure class="workspace-frame">
          <div class="workspace-image">
            <video class="workspace-video" autoplay muted loop playsinline preload="metadata" poster="/videos/justdb-demo-poster.jpg" width="1920" height="1080" aria-label="JustDB product demo">
              <source src="/videos/justdb-demo.mp4" type="video/mp4" />
              Your browser does not support embedded video. <a href="/videos/justdb-demo.mp4">Download the JustDB demo.</a>
            </video>
          </div>
          <figcaption><span>See JustDB in action.</span> Watch the workspace, query editor, and tools in this short demo.</figcaption>
        </figure>
      </section>

      <section id="features" class="feature-stories shell" aria-label="Features">
        <div class="section-intro"><h2>Less setup.<br />More understanding.</h2><p>From the first connection to the next query,<br class="desktop-break" /> everything stays close to your data.</p></div>
        <div class="feature-grid">
        {[
          { title: 'Your data, in the dark.', body: 'Browse tables, filter rows, and move between queries in a quiet dark workspace.', image: 'database-dark', alt: 'JustDB in dark mode showing the users table in the demo SQLite database.', caption: 'Dark mode · Demo SQLite database' },
          { title: 'A lighter view.', body: 'The same tables, tools, and layout in light mode. Choose either appearance, or follow your system setting.', image: 'database-light', alt: 'JustDB in light mode showing the same users table and layout in the demo SQLite database.', caption: 'Light mode · Same database, same view' },
        ].map(feature => (
          <article class="feature-story">
            <div class="feature-copy"><h2>{feature.title}</h2><p>{feature.body}</p></div>
            <figure>
              <div class="feature-image"><span class="feature-crop"><img src={`/features/${feature.image}-1476.webp`} srcset={`/features/${feature.image}-738.webp 738w, /features/${feature.image}-1476.webp 1476w`} sizes="(max-width: 760px) calc(100vw - 96px), (max-width: 1248px) calc(66vw - 100px), 738px" width="1476" height="488" loading="lazy" decoding="async" alt={feature.alt} /></span></div>
              <figcaption>{feature.caption}</figcaption>
            </figure>
          </article>
        ))}
        </div>
      </section>

      <section class="statement shell"><div><h2>Your database.<br /><span class="accent">Your connection.</span></h2>
        </div><div><p>JustDB connects directly from your machine to your database. Saved credentials stay in the OS keychain. There’s no account to create and no sync service to configure — open the app and start exploring.</p><div class="trust-facts"><span>Direct connections</span><span>OS keychain storage</span><span>AI is opt-in</span></div></div>
      </section>

      <section id="faq" class="faq" aria-label="Frequently asked questions">
        <h2>Good to know</h2>
        <details><summary>Is JustDB free?</summary><p>Yes. No account, no trial, and no paid tier. Download the desktop app and connect to your database.</p></details>
        <details><summary>Where are my credentials stored?</summary><p>Saved passwords and auth tokens are stored in your operating system’s keychain. JustDB connects directly to your database.</p></details>
        <details><summary>Does JustDB use AI?</summary><p>AI is optional. Configure your provider or an installed local CLI agent in Settings to ask about your data or draft SQL. You can browse, query, and edit without enabling it.</p></details>
      </section>

      <section class="closing">
        <div class="closing-card">
          <h2>Get straight to <span class="accent">your data.</span></h2>
          <div class="closing-actions"><a class="button" href={downloadUrl}>Download JustDB</a></div>
          <p class="availability">Free, on your desktop. No account needed to start.</p>
        </div>
      </section>
    </main>

    <footer class="shell footer">
      <div class="footer-main">
        <div><a class="brand" href="/" aria-label="JustDB home"><img src="/logo.svg" alt="" width="26" height="26" /><span><span class="accent">just</span><strong>db</strong></span></a><p class="footer-tagline">One place for your database.<br />Browse. Query. Understand.</p></div>
        <div class="footer-links"><div><h2>PRODUCT</h2><a href={downloadUrl}>Download</a><a href="/blog">Blog</a><a href="/compare">Compare</a><a href="/alternatives">Alternatives</a></div><div><h2>ELSEWHERE</h2><a href={REPO_URL}>GitHub</a><a href="https://kreativekorna.com">Just Apps</a></div></div>
      </div>
      <div class="copyright">© {new Date().getFullYear()} JustDB · a just app by <a href="https://kreativekorna.com">KreativeKorna</a></div>
    </footer>
  </div>
</Layout>

<style>
  .landing { min-height:100vh; background:rgb(var(--bg)); color:rgb(var(--text-primary)); }
  .landing :focus-visible { outline:2px solid rgb(var(--accent)); outline-offset:4px; }
  .landing a,.landing button { transition:background-color 150ms,color 150ms,border-color 150ms; }
  .shell { width:100%; max-width:1248px; margin-inline:auto; padding-inline:24px; }
  .nav-wrap { position:sticky; top:0; z-index:20; background:rgb(var(--bg)); border-bottom:1px solid rgb(var(--border)); }
  .nav { display:flex; align-items:center; gap:40px; height:64px; }
  .brand,.nav-actions,.nav-links { display:flex; align-items:center; gap:12px; }
  .brand { font-size:18px; text-decoration:none; color:rgb(var(--text-primary)); flex-shrink:0; }
  .brand strong { font-weight:600; }.brand img { border-radius:4px; }
  .nav-links { gap:26px; font-size:13px; color:rgb(var(--text-secondary)); }
  .nav-actions { margin-left:auto; }
  .nav-actions button { width:36px; height:36px; border:1px solid rgb(var(--border)); border-radius:6px; font-size:22px; color:rgb(var(--text-secondary)); }
  .nav-actions button:hover { background:rgb(var(--bg-elevated)); }
  .button { display:inline-flex; justify-content:center; align-items:center; gap:14px; border:1px solid rgb(var(--accent)); border-radius:6px; background:rgb(var(--accent)); color:rgb(var(--accent-text)); padding:10px 18px; min-height:40px; font-size:14px; font-weight:500; text-decoration:none; }
  .button:hover { background:rgb(var(--text-secondary)); border-color:rgb(var(--text-secondary)); }
  .button.small { min-height:34px; padding:7px 13px; font-size:13px; }
  .button.secondary { background:rgb(var(--bg-elevated)); border-color:rgb(var(--border)); color:rgb(var(--text-primary)); }
  .button.secondary:hover { border-color:rgb(var(--text-muted)); }
  .hero { max-width:840px; padding:96px 24px 0; margin:auto; text-align:center; }
  .eyebrow,.number,.frame-label,.compatibility>span,.footer-links h2 { font-family:inherit; font-size:11px; font-weight:400; letter-spacing:.08em; color:rgb(var(--text-muted)); }
  .eyebrow { margin-bottom:24px; }
  h1 { font-size:clamp(44px,6.5vw,76px); font-weight:400; line-height:1.05; letter-spacing:0; }
  h1 .accent { color:rgb(var(--text-secondary)); }
  .intro { max-width:530px; margin:28px auto 0; font-size:17px; line-height:1.65; color:rgb(var(--text-secondary)); }
  .hero-actions { margin-top:30px; display:flex; justify-content:center; flex-wrap:wrap; gap:12px; }
  .quiet-link { font-size:14px; color:rgb(var(--text-secondary)); }
  .nav-links a:hover,.quiet-link:hover,.footer-links a:hover { color:rgb(var(--text-primary)); }
  .availability { margin-top:18px; font-size:12px; color:rgb(var(--text-muted)); }
  .brew-install { margin:28px auto 0; max-width:450px; }
  .brew-label { display:block; margin-bottom:10px; font-size:12px; color:rgb(var(--text-muted)); }
  .brew-command { display:flex; align-items:center; text-align:left; border:1px solid rgb(var(--border)); border-radius:6px; background:rgb(var(--bg-secondary)); padding:4px; }
  .brew-command code { flex:1; min-width:0; overflow-wrap:anywhere; padding:8px 10px; font-size:12px; }
  .brew-command button { flex-shrink:0; padding:8px 10px; border-left:1px solid rgb(var(--border)); font-size:12px; color:rgb(var(--text-secondary)); }
  .brew-command button:hover { background:rgb(var(--bg-elevated)); }
  .brew-feedback { display:block; min-height:18px; margin-top:4px; font-size:11px; color:rgb(var(--text-muted)); }
  .product-overview { margin-top:44px; }
  .compatibility { display:flex; justify-content:center; align-items:center; gap:30px; margin-bottom:30px; }
  .compatibility div { display:flex; align-items:center; gap:22px; font-size:14px; color:rgb(var(--text-secondary)); }
  .compatibility i { color:rgb(var(--border)); font-style:normal; }
  .workspace-frame { margin:0; border:1px solid rgb(var(--border)); border-radius:12px; overflow:hidden; background:rgb(var(--bg-secondary)); }
  .frame-label { display:flex; justify-content:space-between; padding:16px 20px; border-bottom:1px solid rgb(var(--border)); }
  .workspace-image { display:block; }
  .workspace-video { display:block; width:100%; height:auto; background:#111; }
  .workspace-frame figcaption { display:flex; flex-wrap:wrap; gap:8px; padding:16px 20px; border-top:1px solid rgb(var(--border)); font-size:12px; color:rgb(var(--text-muted)); }
  .workspace-frame figcaption span { color:rgb(var(--text-primary)); }
  .feature-stories { margin-top:96px; scroll-margin-top:90px; }
  .section-intro { margin-bottom:40px; }
  .section-intro h2,.statement h2 { font-size:clamp(30px,4vw,42px); line-height:1.15; font-weight:400; letter-spacing:0; }
  .section-intro>p:last-child { margin-top:20px; font-size:16px; line-height:1.6; color:rgb(var(--text-secondary)); }
  .feature-grid { position:relative; isolation:isolate; display:grid; grid-template-columns:1fr; gap:20px; }

  .feature-grid { align-items:start; }
  .feature-story {
    position:relative; z-index:1; border:1px solid rgb(255 255 255 / .16);
    border-radius:12px; background:rgb(18 18 18 / .28);
    backdrop-filter:blur(24px); -webkit-backdrop-filter:blur(24px);
    box-shadow:inset 0 1px 0 rgb(255 255 255 / .23), inset 1px 0 0 rgb(255 255 255 / .06), inset 0 -1px 0 rgb(255 255 255 / .04), 0 16px 40px -24px rgb(0 0 0 / .6);
    padding:32px; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,2fr); gap:32px; align-items:center; overflow:hidden;
  }
  /* These shapes sit behind the cards: sharp in the gaps, diffused through glass. */
  .feature-grid::before {
    content:''; position:absolute; inset:0; z-index:0; pointer-events:none;
    background:
      radial-gradient(ellipse at 48% 26%, rgb(255 255 255 / .14), transparent 46%),
      repeating-linear-gradient(120deg, transparent 0 155px, rgb(255 255 255 / .07) 156px 158px, transparent 159px 310px);
    mask-image:linear-gradient(transparent, #000 12%, #000 85%, transparent);
  }
  .feature-grid::after {
    content:''; position:absolute; width:76%; height:240px; left:12%; top:140px;
    border:1px solid rgb(255 255 255 / .25); border-radius:50%;
    background:rgb(255 255 255 / .065); transform:rotate(-24deg);
    z-index:0; pointer-events:none;
  }
  .landing[data-theme='light'] .feature-story {
    background:rgb(255 255 255 / .32); border-color:rgb(0 0 0 / .1);
    box-shadow:inset 0 1px 0 rgb(255 255 255 / .95), inset 1px 0 0 rgb(255 255 255 / .55), 0 16px 40px -24px rgb(0 0 0 / .2);
  }
  .landing[data-theme='light'] .feature-grid::before {
    background:radial-gradient(ellipse at 48% 26%, rgb(0 0 0 / .1), transparent 46%),
      repeating-linear-gradient(120deg, transparent 0 155px, rgb(0 0 0 / .07) 156px 158px, transparent 159px 310px);
  }
  .landing[data-theme='light'] .feature-grid::after { border-color:rgb(0 0 0 / .15); background:rgb(0 0 0 / .045); }
  @supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))) {
    .feature-story { background:rgb(var(--bg-secondary)); }
  }
  @media(prefers-reduced-transparency:reduce) {
    .feature-story { background:rgb(var(--bg-secondary)) !important; backdrop-filter:none; -webkit-backdrop-filter:none; }
    .feature-grid::before,.feature-grid::after { display:none; }
  }
  .feature-copy h2 { font-size:24px; line-height:1.33; font-weight:400; margin-bottom:14px; }
  .feature-copy p { font-size:14px; line-height:1.65; color:rgb(var(--text-secondary)); }
  .feature-story figure { min-width:0; margin:0; width:100%; max-width:738px; }
  .feature-image { display:block; border:1px solid rgb(var(--border)); border-radius:6px; overflow:hidden; }
  .feature-crop { display:block; position:relative; overflow:hidden; }
  .feature-crop img { display:block; width:100%; height:auto; }
  .feature-story figcaption { margin-top:12px; font-size:12px; line-height:1.5; color:rgb(var(--text-muted)); }
  .statement { margin-top:96px; display:grid; grid-template-columns:1fr 1fr; gap:64px; padding-block:48px; border-top:1px solid rgb(var(--border)); border-bottom:1px solid rgb(var(--border)); }
  .statement p:not(.eyebrow) { font-size:16px; line-height:1.75; color:rgb(var(--text-secondary)); }
  .trust-facts { display:flex; flex-wrap:wrap; gap:12px 20px; margin-top:24px; font-family:inherit; font-size:11px; color:rgb(var(--text-primary)); }
  .trust-facts span::before { content:'✓'; margin-right:8px; }
  .faq { max-width:760px; margin:96px auto 0; padding-inline:24px; scroll-margin-top:90px; }
  .faq h2 { font-size:30px; font-weight:400; margin-bottom:24px; }
  .faq details { border-bottom:1px solid rgb(var(--border)); padding:20px 0; }
  .faq summary { cursor:pointer; font-size:15px; }
  .faq p { margin-top:14px; font-size:14px; line-height:1.7; color:rgb(var(--text-secondary)); }
  .closing { margin:96px auto 0; border-block:1px solid rgb(var(--border)); background:rgb(var(--bg-secondary)); }
  .closing-card { width:100%; max-width:960px; margin-inline:auto; padding:72px 24px; text-align:center; }
  .closing h2 { font-size:clamp(32px,4.5vw,48px); font-weight:400; line-height:1.15; letter-spacing:0; }
  .closing-actions { margin-top:28px; display:flex; align-items:center; justify-content:center; gap:20px; }
  .footer { padding-top:64px; }
  .footer-main { display:flex; justify-content:space-between; flex-wrap:wrap; gap:40px; }
  .footer-tagline { margin-top:18px; font-size:14px; line-height:1.6; color:rgb(var(--text-muted)); }
  .footer-links { display:flex; gap:80px; }
  .footer-links h2 { margin-bottom:20px; }
  .footer-links a { display:block; margin-top:14px; font-size:13px; color:rgb(var(--text-secondary)); }
  .copyright { border-top:1px solid rgb(var(--border)); margin-top:48px; padding:24px 0; font-size:12px; color:rgb(var(--text-muted)); }
  @media(max-width:760px) { .nav { gap:20px; }.nav-links { gap:16px; }.nav-links a:last-child { display:none; }.feature-grid,.statement { grid-template-columns:1fr; }.statement { gap:28px; }.feature-story { padding:24px; grid-template-columns:1fr; }.hero { padding-top:64px; }.compatibility { flex-direction:column; gap:16px; }.frame-label span:last-child { display:none; }.feature-stories,.statement,.faq,.closing { margin-top:64px; } }
  @media(max-width:480px) { .nav-links { display:none; }.nav { gap:12px; }.nav-actions { gap:8px; }.shell { padding-inline:16px; }.hero { padding-inline:20px; } h1 { font-size:44px; }.intro { font-size:16px; }.feature-story { padding:20px; }.footer-links { gap:60px; }.closing-actions { flex-direction:column; gap:16px; }.desktop-break { display:none; } }
  @media(prefers-reduced-motion:reduce) { .landing a,.landing button { transition:none; } }
</style>

<script>
  // Detect the platform only to label the explicit download link.
  type OS = 'macos' | 'windows' | 'linux';

  function detectOS(): OS | null {
    // navigator.platform is frozen in modern browsers; prefer the UA-CH hint
    // where available, then fall back to userAgent + platform sniffing.
    const uaData = (navigator as any).userAgentData;
    const hint = `${navigator.userAgent} ${uaData?.platform ?? navigator.platform ?? ''}`;
    if (/Mac|iPhone|iPad|iPod/i.test(hint)) return 'macos';
    if (/Win/i.test(hint)) return 'windows';
    if (/Linux|X11|CrOS/i.test(hint)) return 'linux';
    return null;
  }

  const os = detectOS();
  const osLabel: Record<OS, string> = {
    macos: 'Download for macOS',
    windows: 'Download for Windows',
    linux: 'View releases for Linux',
  };

  const download = document.getElementById('cta-download');
  if (download instanceof HTMLAnchorElement && os) {
    const osDownloadUrl = download.dataset[
      os === 'macos' ? 'downloadMacos' : os === 'windows' ? 'downloadWindows' : 'downloadLinux'
    ];
    if (osDownloadUrl) {
      download.href = osDownloadUrl;
      download.textContent = osLabel[os];
    }
  }

  document.getElementById('copy-brew')?.addEventListener('click', async () => {
    const command = document.getElementById('brew-command')?.textContent;
    const feedback = document.getElementById('brew-feedback');
    if (!command || !feedback) return;
    try {
      await navigator.clipboard.writeText(command);
      feedback.textContent = 'Copied';
    } catch {
      feedback.textContent = 'Select the command above to copy it.';
    }
  });
</script>
