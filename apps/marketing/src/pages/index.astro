---
import Layout from '../layouts/Layout.astro';
import { LAUNCH_URL, RELEASES_URL, REPO, REPO_URL } from '../lib/site';
import { organizationJsonLd, softwareApplicationJsonLd, websiteJsonLd } from '../lib/seo';
const downloadUrl = RELEASES_URL;

// Resolve direct installer URLs for the latest release at build time so the
// device-detected CTA links straight to the right file. Asset names carry the
// version (e.g. JustDB_0.2.3_x64-setup.exe), so we can't hardcode them — we
// match by extension against the latest release. Any failure or missing asset
// falls back to the releases page.
async function resolveDownloads(): Promise<Record<'macos' | 'windows' | 'linux', string>> {
  const fallback = { macos: downloadUrl, windows: downloadUrl, linux: downloadUrl };
  try {
    const res = await fetch(`https://api.github.com/repos/${REPO}/releases/latest`, {
      headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'justdb-marketing' },
    });
    if (!res.ok) return fallback;
    const { assets = [] } = (await res.json()) as {
      assets?: { name: string; browser_download_url: string }[];
    };
    const find = (re: RegExp) => assets.find((a) => re.test(a.name))?.browser_download_url;
    return {
      macos: find(/\.dmg$/i) ?? downloadUrl,
      // NSIS setup is the standard user installer; .msi is the fallback.
      windows: find(/-setup\.exe$/i) ?? find(/\.msi$/i) ?? downloadUrl,
      // Linux bundles aren't published — send them to the releases page.
      linux: downloadUrl,
    };
  } catch {
    return fallback;
  }
}
const downloads = await resolveDownloads();

---

<Layout jsonLd={[organizationJsonLd, websiteJsonLd, softwareApplicationJsonLd()]}>
  <div class="landing" id="landing" data-theme="dark">
    <nav class="nav shell" aria-label="Main">
      <a class="brand" href="/" aria-label="JustDB home"><img src="/logo.svg" alt="" width="28" height="28" /><span><span class="accent">just</span><strong>db</strong></span></a>
      <div class="nav-actions">
        <button id="theme-toggle" type="button" aria-label="Switch to light theme" aria-pressed="false" title="Toggle light/dark">☼</button>
        <a class="button small" href={LAUNCH_URL} data-fallback={downloadUrl}>Open JustDB</a>
      </div>
    </nav>

    <main>
      <header class="hero">
        <p class="eyebrow">A DESKTOP DATABASE CLIENT</p>
        <h1>Just your data.<br /><span class="accent">No bullshit.</span></h1>
        <p class="intro">Browse PostgreSQL, SQLite, and Turso. Run SQL, follow relationships, and review edits before saving — all from your desktop.</p>
        <div class="hero-actions">
          <a class="text-link" id="cta-download" href={downloadUrl} data-download-macos={downloads.macos} data-download-windows={downloads.windows} data-download-linux={downloads.linux}>Download JustDB</a>
          <a class="quiet-link" href={LAUNCH_URL} data-fallback={downloadUrl}>open the app</a>
        </div>
        <p class="availability">Free · macOS & Windows · No account needed</p>
        <div class="brew-install">
          <span class="brew-label">Or install with Homebrew on macOS</span>
          <div class="brew-command"><code id="brew-command">brew install --cask codellyson/tap/justdb</code><button id="copy-brew" type="button" aria-label="Copy Homebrew install command">Copy</button></div>
          <span id="brew-feedback" role="status" class="brew-feedback"></span>
        </div>
      </header>

      <section id="features" class="feature-stories" aria-label="Features">
        {[
          { n: '01', title: 'Pick up where you left off.', body: 'Keep your saved connections together and discover PostgreSQL servers running on your machine. Choose a connection and get straight to your data.', image: 'connections', x: 1220, y: 200, width: 1160, height: 1100, alt: 'Saved database connections and two locally detected PostgreSQL servers.', caption: 'Saved connections and local discovery, together.' },
          { n: '02', title: 'Get the whole record.', body: 'Browse your tables, filter the grid, and select a record to see its fields in the row details panel. Keep the table in view while you inspect individual values.', image: 'row-details', x: 480, y: 140, width: 3120, height: 1350, alt: 'The users table with Ada Lovelace selected and her fields visible in the row details panel.', caption: 'The grid and record inspector stay side by side.' },
          { n: '03', title: 'Ask. Review. Then run.', body: 'Ask the optional AI assistant about your data. When you request a change, inspect the proposed SQL and open it in the editor before running it. Here, a deletion is explicitly marked “Not run.”', image: 'ai-review', x: 1750, y: 80, width: 930, height: 1210, alt: 'AI answering a row-count question and showing a proposed deletion with Review in editor and Copy SQL actions.', caption: 'Proposed changes remain yours to review and execute.' },
          { n: '04', title: 'Make values easier to read.', body: 'Choose relative dates, pretty JSON, boolean badges, and comma-separated numbers. Control how values appear in your tables from the docked formatting settings.', image: 'formatting', x: 2680, y: 0, width: 920, height: 1160, alt: 'Formatting settings with controls for dates, JSON, booleans, numbers, and long text.', caption: 'Display preferences within reach of your workspace.' },
          { n: '05', title: 'A workspace that feels familiar.', body: 'Switch between light and dark modes, then choose a theme such as GitHub, Gruvbox, Nord, or Solarized. Adjust the look while keeping your query and results open.', image: 'themes', x: 2680, y: 0, width: 920, height: 950, alt: 'Appearance settings showing the available themes with Gruvbox selected.', caption: 'Your theme, across the editor, tables, and settings.' },
        ].map(feature => (
          <article class:list={["feature-story", { "feature-wide": feature.image === "row-details" }]}>
            <div class="feature-copy"><span class="number">{feature.n}</span><h2>{feature.title}</h2><p>{feature.body}</p></div>
            <figure>
              <a href={`/features/${feature.image}.png`} target="_blank" rel="noopener" aria-label={`View full-size screenshot: ${feature.title}`}><span class="feature-crop" style={`aspect-ratio:${feature.width}/${feature.height}`}><img src={`/features/${feature.image}.png`} style={`width:${3600 / feature.width * 100}%;left:${-feature.x / feature.width * 100}%;top:${-feature.y / feature.height * 100}%`} loading="lazy" decoding="async" alt={feature.alt} /></span></a>
              <figcaption>{feature.caption}</figcaption>
            </figure>
          </article>
        ))}
      </section>

      <section class="statement">
        <h2>Your database.<br /><span class="accent">Your connection.</span></h2>
        <p>JustDB connects directly from your machine to your database. Saved credentials stay in the OS keychain. There’s no account to create and no sync service to configure — open the app and start exploring.</p>
      </section>

      <section id="faq" class="faq" aria-label="Frequently asked questions">
        <h2>Good to know</h2>
        <details><summary>Is JustDB free?</summary><p>Yes. No account, no trial, and no paid tier. Download the desktop app and connect to your database.</p></details>
        <details><summary>Where are my credentials stored?</summary><p>Saved passwords and auth tokens are stored in your operating system’s keychain. JustDB connects directly to your database.</p></details>
        <details><summary>Does JustDB use AI?</summary><p>AI is optional. Configure your provider or an installed local CLI agent in Settings to ask about your data or draft SQL. You can browse, query, and edit without enabling it.</p></details>
      </section>

      <section class="closing">
        <div class="closing-card">
          <p class="eyebrow">READY WHEN YOU ARE</p>
          <h2>Get straight<br />to <span class="accent">your data.</span></h2>
          <div class="closing-actions"><a class="button" href={LAUNCH_URL} data-fallback={downloadUrl}>Open JustDB</a><a class="quiet-link" href={downloadUrl}>or download the app</a></div>
          <p class="availability">Free, on your desktop. No account needed to start.</p>
        </div>
      </section>
    </main>

    <footer class="shell footer">
      <div class="footer-main">
        <div><a class="brand" href="/" aria-label="JustDB home"><img src="/logo.svg" alt="" width="26" height="26" /><span><span class="accent">just</span><strong>db</strong></span></a><p class="footer-tagline">One place for your database.<br />Browse. Query. Understand.</p></div>
        <div class="footer-links"><div><h2>PRODUCT</h2><a href={downloadUrl}>Download</a><a href="/compare">Compare</a><a href="/guides">Guides</a><a href="/alternatives">Alternatives</a></div><div><h2>ELSEWHERE</h2><a href={REPO_URL}>GitHub</a><a href="https://kreativekorna.com">Just Apps</a></div></div>
      </div>
      <div class="copyright">© {new Date().getFullYear()} JustDB · a just app by <a href="https://kreativekorna.com">KreativeKorna</a></div>
    </footer>
  </div>
</Layout>

<style>
  .landing { --bg: 17 17 17; --bg-secondary: 24 24 24; --bg-elevated: 32 32 32; --border: 48 48 48; --text-primary: 250 250 250; --text-secondary: 170 170 170; --text-muted: 145 145 145; --accent: 255 255 255; --accent-text: 17 17 17; color-scheme:dark; min-height:100vh; background:rgb(var(--bg)); color:rgb(var(--text-primary)); overflow-x:clip; }
  .landing[data-theme='light'] { --bg: 255 255 255; --bg-secondary: 247 247 247; --bg-elevated: 238 238 238; --border: 220 220 220; --text-primary: 17 17 17; --text-secondary: 85 85 85; --text-muted: 110 110 110; --accent: 17 17 17; --accent-text: 255 255 255; color-scheme:light; }
  .landing :focus-visible { outline-color:rgb(var(--accent)); }
  .shell { max-width:1080px; margin-inline:auto; padding-inline:48px; }
  .nav { display:flex; align-items:center; justify-content:space-between; padding-block:32px; }
  .brand,.nav-actions { display:flex; align-items:center; gap:12px; }
  .brand { font-size:15px; text-decoration:none; }
  .brand img { border-radius:5px; }
  .accent { color:rgb(var(--accent)); }
  .nav-actions button { width:32px; height:32px; border:1px solid rgb(var(--border)); border-radius:8px; font-size:22px; color:rgb(var(--text-secondary)); }
  .button { display:inline-flex; justify-content:center; align-items:center; border-radius:12px; background:rgb(var(--accent)); color:rgb(var(--accent-text)); padding:15px 28px; font-size:15px; font-weight:600; text-decoration:none; transition:opacity 150ms; }
  .button:hover { opacity:.85; }
  .button.small { padding:10px 18px; font-size:14px; border-radius:10px; }
  .hero { max-width:820px; padding:84px 24px 0; margin:auto; text-align:center; }
  .eyebrow { font-size:11px; letter-spacing:.16em; color:rgb(var(--text-muted)); margin-bottom:30px; }
  h1 { font-size:clamp(42px,6vw,72px); font-weight:800; line-height:1.02; letter-spacing:-.045em; }
  .intro { max-width:490px; margin:30px auto 0; font-size:19px; line-height:1.65; color:rgb(var(--text-secondary)); }
  .hero-actions { margin-top:38px; display:flex; align-items:baseline; justify-content:center; flex-wrap:wrap; gap:28px; }
  .text-link { border-bottom:1.5px solid rgb(var(--accent)); padding-bottom:4px; font-size:16px; font-weight:600; }
  .quiet-link { font-size:15px; color:rgb(var(--text-muted)); font-weight:500; }
  a:hover { color:rgb(var(--accent)); }
  .button:hover { color:rgb(var(--accent-text)); }
  .availability { margin-top:22px; font-size:13px; color:rgb(var(--text-muted)); }
  .brew-install { margin:26px auto 0; max-width:490px; }
  .brew-label { display:block; margin-bottom:10px; font-size:12px; color:rgb(var(--text-muted)); }
  .brew-command { display:flex; align-items:center; text-align:left; border:1px solid rgb(var(--border)); border-radius:10px; background:rgb(var(--bg-secondary)); padding:5px; }
  .brew-command code { flex:1; min-width:0; overflow-wrap:anywhere; padding:8px; font-size:12px; }
  .brew-command button { flex-shrink:0; padding:8px 10px; border-radius:6px; font-size:12px; color:rgb(var(--text-secondary)); }
  .brew-command button:hover { background:rgb(var(--bg-elevated)); color:rgb(var(--text-primary)); }
  .brew-feedback { display:block; min-height:18px; margin-top:4px; font-size:11px; color:rgb(var(--text-muted)); }
  .number { display:block; margin-bottom:18px; font-size:24px; font-weight:800; color:rgb(var(--accent)); }
  .feature-stories { max-width:1280px; margin:100px auto 0; padding-inline:24px; }
  .feature-story { display:grid; grid-template-columns:minmax(220px, .7fr) minmax(0, 1.6fr); align-items:center; gap:48px; padding-block:64px; border-top:1px solid rgb(var(--border)); }
  .feature-copy h2 { font-size:clamp(26px,3vw,36px); line-height:1.12; letter-spacing:-.035em; font-weight:700; margin-bottom:20px; }
  .feature-copy p { font-size:16px; line-height:1.75; color:rgb(var(--text-secondary)); }
  .feature-story figure { min-width:0; margin:0; width:100%; max-width:570px; justify-self:center; }
  .feature-story a { display:block; border:1px solid rgb(var(--border)); border-radius:10px; overflow:hidden; }
  .feature-crop { display:block; position:relative; overflow:hidden; }
  .feature-crop img { display:block; position:absolute; max-width:none; height:auto; }
  .feature-wide { grid-template-columns:1fr; gap:28px; }
  .feature-wide .feature-copy { max-width:560px; }
  .feature-wide figure { max-width:none; }
  .feature-story figcaption { margin-top:12px; font-size:12px; line-height:1.6; color:rgb(var(--text-muted)); }
  @media(max-width:800px) { .feature-story { grid-template-columns:1fr; gap:24px; padding-block:40px; } .feature-copy { max-width:540px; } .feature-stories { margin-top:64px; } }
  .statement { max-width:760px; margin:140px auto 0; padding-inline:24px; text-align:center; }
  .statement h2 { font-size:clamp(32px,4.5vw,46px); font-weight:800; line-height:1.1; letter-spacing:-.04em; }
  .statement p { max-width:520px; margin:34px auto 0; font-size:17px; line-height:1.65; color:rgb(var(--text-secondary)); }
  .faq { max-width:640px; margin:88px auto 0; padding-inline:24px; }
  .faq h2 { font-size:19px; font-weight:600; margin-bottom:16px; }
  .faq details { border-bottom:1px solid rgb(var(--border)); padding:18px 0; }
  .faq summary { cursor:pointer; font-size:15px; }
  .faq p { margin-top:12px; font-size:14px; line-height:1.65; color:rgb(var(--text-secondary)); }
  .closing { max-width:860px; padding-inline:48px; margin:140px auto 0; }
  .closing-card { border:1px solid rgb(var(--border)); border-radius:24px; background:rgb(var(--bg-secondary)); padding:90px 24px; text-align:center; box-shadow:0 30px 70px -42px rgb(0 0 0 / .5); }
  .closing h2 { font-size:clamp(32px,4.8vw,48px); font-weight:800; line-height:1.04; letter-spacing:-.04em; }
  .closing-actions { margin-top:38px; display:flex; align-items:center; justify-content:center; gap:22px; }
  .footer { margin-top:140px; }
  .footer-main { display:flex; justify-content:space-between; flex-wrap:wrap; gap:40px; border-top:1px solid rgb(var(--border)); padding-top:48px; }
  .footer-tagline { margin-top:16px; font-size:18px; line-height:1.45; color:rgb(var(--text-secondary)); }
  .footer-links { display:flex; gap:64px; }
  .footer-links h2 { margin-bottom:16px; font-size:11px; letter-spacing:.14em; color:rgb(var(--text-muted)); }
  .footer-links a { display:block; margin-top:12px; font-size:14px; color:rgb(var(--text-secondary)); }
  .copyright { border-top:1px solid rgb(var(--border)); margin-top:48px; padding:22px 0 52px; font-size:12px; color:rgb(var(--text-muted)); }
  @media(max-width:640px) { .shell { padding-inline:24px; } .nav { padding-block:24px; } .hero { padding-top:56px; } .intro { font-size:17px; } .statement,.closing,.footer { margin-top:88px; } .closing { padding-inline:16px; } .closing-card { padding:56px 24px; } .closing-actions { flex-direction:column; gap:16px; } .footer-links { gap:40px; } }
</style>

<script>
  // ── Download / launch CTAs ───────────────────────────────────────────────
  //
  // "Open JustDB" points at `justdb://open`, so a native click hands the URL to
  // the OS and an installed app launches with no JS involved. If nothing is
  // registered, the tab stays visible — after ~1.5s we send them to the best
  // download we have. Mobile has no desktop app to launch, so the href is
  // swapped up-front.
  type OS = 'macos' | 'windows' | 'linux';

  function detectOS(): OS | null {
    // navigator.platform is frozen in modern browsers; prefer the UA-CH hint
    // where available, then fall back to userAgent + platform sniffing.
    const uaData = (navigator as any).userAgentData;
    const hint = `${navigator.userAgent} ${uaData?.platform ?? navigator.platform ?? ''}`;
    if (/Mac|iPhone|iPad|iPod/i.test(hint)) return 'macos';
    if (/Win/i.test(hint)) return 'windows';
    if (/Linux|X11|CrOS/i.test(hint)) return 'linux';
    return null;
  }

  const os = detectOS();
  const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
  const osLabel: Record<OS, string> = {
    macos: 'Download for macOS',
    windows: 'Download for Windows',
    linux: 'View releases for Linux',
  };

  const download = document.getElementById('cta-download');
  let osDownloadUrl: string | undefined;
  if (download instanceof HTMLAnchorElement && os) {
    osDownloadUrl = download.dataset[
      os === 'macos' ? 'downloadMacos' : os === 'windows' ? 'downloadWindows' : 'downloadLinux'
    ];
    if (osDownloadUrl) {
      download.href = osDownloadUrl;
      download.textContent = osLabel[os];
    }
  }

  for (const el of document.querySelectorAll<HTMLAnchorElement>('a[data-fallback]')) {
    const fallback = osDownloadUrl ?? el.dataset.fallback;
    if (!fallback) continue;
    if (isMobile) {
      el.href = fallback;
      continue;
    }
    el.addEventListener('click', () => {
      window.setTimeout(() => {
        if (!document.hidden) window.location.href = fallback;
      }, 1500);
    });
  }


  const landing = document.getElementById('landing');
  document.getElementById('copy-brew')?.addEventListener('click', async () => {
    const command = document.getElementById('brew-command')?.textContent;
    const feedback = document.getElementById('brew-feedback');
    if (!command || !feedback) return;
    try {
      await navigator.clipboard.writeText(command);
      feedback.textContent = 'Copied';
    } catch {
      feedback.textContent = 'Select the command above to copy it.';
    }
  });
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const light = landing?.dataset.theme !== 'light';
    if (landing) landing.dataset.theme = light ? 'light' : 'dark';
    toggle.setAttribute('aria-pressed', String(light));
    toggle.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
  });
</script>
