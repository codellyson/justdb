---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageScripts from '../../components/PageScripts.astro';
import { COMPARISONS } from '../../lib/comparisons';
import { breadcrumbJsonLd, webPageJsonLd } from '../../lib/seo';

const title = 'Compare JustDB — vs DBeaver, pgAdmin and Beekeeper Studio';
const description =
  'Honest, side-by-side comparisons of JustDB against DBeaver, pgAdmin and Beekeeper Studio — architecture, database support, pricing and everyday workflow.';
const path = '/compare';

const jsonLd = [
  webPageJsonLd({ title, description, path }),
  breadcrumbJsonLd([
    { name: 'JustDB', path: '/' },
    { name: 'Compare', path },
  ]),
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Nav />

  <main>
    <section class="relative overflow-hidden border-b border-border">
      <div class="bg-grid pointer-events-none absolute inset-x-0 top-0 h-[360px]" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-shell px-5 pb-14 pt-12 sm:px-8 sm:pt-16">
        <Breadcrumb trail={[{ name: 'JustDB', path: '/' }, { name: 'Compare' }]} />
        <div class="mt-8 max-w-3xl">
          <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted" data-reveal>Compare</p>
          <h1
            class="mt-3 text-[clamp(2.2rem,5.4vw,3.6rem)] font-semibold leading-[1.05] tracking-[-0.03em] text-primary"
            data-reveal
          >
            How JustDB compares.
          </h1>
          <p class="mt-6 max-w-2xl text-[17px] leading-relaxed text-secondary" data-reveal>
            Thinking about switching database clients? These are honest,
            side-by-side comparisons — including where the other tool is the
            better pick. JustDB is a small, native app for browsing, querying and
            editing PostgreSQL, SQLite and Turso.
          </p>
        </div>
      </div>
    </section>

    <section>
      <div class="mx-auto max-w-shell px-5 py-16 sm:px-8 sm:py-24">
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {COMPARISONS.map((c) => (
            <li data-reveal>
              <a
                href={`/compare/${c.slug}`}
                class="group flex h-full flex-col rounded-xl border border-border bg-bg-secondary/40 p-7 transition-[transform,border-color] duration-300 hover:-translate-y-1 hover:border-border-strong"
              >
                <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted">Versus</p>
                <h2 class="mt-2 text-[18px] font-semibold tracking-tight text-primary">
                  JustDB vs {c.competitor}
                </h2>
                <p class="mt-3 flex-1 text-[14px] leading-relaxed text-secondary">{c.them}</p>
                <span class="mt-5 inline-flex items-center gap-1.5 text-[14px] font-medium text-accent">
                  See the comparison
                  <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <CtaBand />
  <Footer />
  <PageScripts />
</Layout>
