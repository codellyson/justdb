---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageScripts from '../../components/PageScripts.astro';
import Button from '../../components/Button.astro';
import { COMPARISONS } from '../../lib/comparisons';
import { LAUNCH_URL, RELEASES_URL } from '../../lib/site';
import {
  breadcrumbJsonLd,
  faqJsonLd,
  softwareApplicationJsonLd,
  webPageJsonLd,
} from '../../lib/seo';

export function getStaticPaths() {
  return COMPARISONS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const path = `/compare/${c.slug}`;

const jsonLd = [
  webPageJsonLd({ title: c.title, description: c.description, path }),
  breadcrumbJsonLd([
    { name: 'JustDB', path: '/' },
    { name: 'Compare', path: '/compare' },
    { name: `vs ${c.competitor}`, path },
  ]),
  softwareApplicationJsonLd(),
  faqJsonLd(c.faq),
];
---

<Layout title={c.title} description={c.description} jsonLd={jsonLd}>
  <Nav />

  <main>
    <!-- ── Hero ──────────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden border-b border-border">
      <div class="bg-grid pointer-events-none absolute inset-x-0 top-0 h-[420px]" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-shell px-5 pb-14 pt-12 sm:px-8 sm:pt-16">
        <Breadcrumb
          trail={[
            { name: 'JustDB', path: '/' },
            { name: 'Compare', path: '/compare' },
            { name: `vs ${c.competitor}` },
          ]}
        />
        <div class="mt-8 max-w-3xl">
          <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted" data-reveal>{c.eyebrow}</p>
          <h1
            class="mt-3 text-[clamp(2.2rem,5.4vw,3.6rem)] font-semibold leading-[1.05] tracking-[-0.03em] text-primary"
            data-reveal
          >
            {c.h1}
          </h1>
          <p class="mt-6 max-w-2xl text-[17px] leading-relaxed text-secondary" data-reveal>{c.lead}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-reveal>
            <Button size="lg" href={LAUNCH_URL} data-fallback={RELEASES_URL} class="w-full sm:w-auto">
              Open JustDB
              <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
            </Button>
            <Button size="lg" variant="secondary" href={RELEASES_URL} external class="w-full sm:w-auto">
              Download desktop app
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Comparison table ──────────────────────────────────────────────── -->
    <section class="border-b border-border">
      <div class="mx-auto max-w-shell px-5 py-16 sm:px-8 sm:py-24">
        <div class="max-w-2xl" data-reveal>
          <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted">Side by side</p>
          <h2 class="mt-3 text-[clamp(1.8rem,4vw,2.6rem)] font-semibold leading-[1.1] tracking-[-0.025em] text-primary">
            JustDB vs {c.competitor}
          </h2>
        </div>

        <div class="mt-10 overflow-x-auto" data-reveal>
          <table class="w-full min-w-[640px] border-collapse text-left">
            <thead>
              <tr class="border-b border-border-strong">
                <th class="w-1/3 py-4 pr-4 text-[11px] font-medium uppercase tracking-[0.12em] text-muted"></th>
                <th class="py-4 pr-4 text-[15px] font-semibold text-primary">
                  <span class="inline-flex items-center gap-2">
                    <img src="/logo.svg" alt="" width="18" height="18" class="rounded-[4px]" aria-hidden="true" />
                    JustDB
                  </span>
                </th>
                <th class="py-4 text-[15px] font-semibold text-secondary">{c.competitor}</th>
              </tr>
            </thead>
            <tbody>
              {c.rows.map((row) => (
                <tr class="border-b border-border align-top">
                  <th scope="row" class="py-4 pr-4 text-[13px] font-medium text-muted">{row.label}</th>
                  <td class={`py-4 pr-4 text-[14px] leading-relaxed ${row.win ? 'text-primary' : 'text-secondary'}`}>
                    <span class="flex gap-2">
                      {row.win && (
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-success" aria-hidden="true">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                      )}
                      <span>{row.justdb}</span>
                    </span>
                  </td>
                  <td class="py-4 text-[14px] leading-relaxed text-muted">{row.them}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-[12px] text-muted" data-reveal>
          Comparison reflects publicly documented behaviour and pricing models; product details can change.
        </p>
      </div>
    </section>

    <!-- ── Why switch ────────────────────────────────────────────────────── -->
    <section class="border-b border-border">
      <div class="mx-auto max-w-shell px-5 py-16 sm:px-8 sm:py-24">
        <div class="max-w-2xl" data-reveal>
          <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted">Why developers switch</p>
          <h2 class="mt-3 text-[clamp(1.8rem,4vw,2.6rem)] font-semibold leading-[1.1] tracking-[-0.025em] text-primary">
            Less tool, more database.
          </h2>
        </div>
        <ul class="mt-10 grid gap-4 sm:grid-cols-3">
          {c.switchReasons.map(({ title, body }) => (
            <li class="rounded-xl border border-border bg-bg-secondary/40 p-6" data-reveal>
              <h3 class="text-[15px] font-medium text-primary">{title}</h3>
              <p class="mt-2 text-[14px] leading-relaxed text-secondary">{body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── When the other tool wins (honest) ─────────────────────────────── -->
    <section class="border-b border-border">
      <div class="mx-auto max-w-shell px-5 py-16 sm:px-8 sm:py-24">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
          <div data-reveal>
            <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted">Being fair</p>
            <h2 class="mt-3 text-[clamp(1.6rem,3.4vw,2.3rem)] font-semibold leading-[1.1] tracking-[-0.025em] text-primary">
              When {c.competitor} is the better pick.
            </h2>
            <p class="mt-5 text-[15px] leading-relaxed text-secondary">
              JustDB is deliberately small. If any of these describe you,
              {' '}{c.competitor} is the right tool — and we would rather say so.
            </p>
          </div>
          <ul class="space-y-3" data-reveal>
            {c.whenThem.map((item) => (
              <li class="flex gap-3 rounded-xl border border-border p-5 text-[14px] leading-relaxed text-secondary">
                <span class="mt-[7px] h-1 w-1 shrink-0 rounded-full bg-muted"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ── FAQ ───────────────────────────────────────────────────────────── -->
    <section class="border-b border-border">
      <div class="mx-auto max-w-shell px-5 py-16 sm:px-8 sm:py-24">
        <div class="grid gap-12 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)]">
          <div data-reveal>
            <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted">FAQ</p>
            <h2 class="mt-3 text-[clamp(1.8rem,4vw,2.6rem)] font-semibold leading-[1.08] tracking-[-0.025em] text-primary">
              Common questions.
            </h2>
          </div>
          <div class="divide-y divide-border border-y border-border" data-reveal>
            {c.faq.map(({ q, a }) => (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[15px] font-medium text-primary transition-colors hover:text-accent [&::-webkit-details-marker]:hidden">
                  {q}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="shrink-0 text-muted transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </summary>
                <p class="max-w-2xl pb-6 text-[14px] leading-relaxed text-secondary">{a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <CtaBand
    title={`Try the ${c.competitor} alternative.`}
    body="Open JustDB, connect, and see your data in under a minute. Free, no signup."
    class="border-t-0"
  />

  <Footer />
  <PageScripts />
</Layout>
