---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageScripts from '../../components/PageScripts.astro';
import Button from '../../components/Button.astro';
import AppFrame from '../../components/AppFrame.astro';
import BrowseMock from '../../components/mock/BrowseMock.astro';
import QueryMock from '../../components/mock/QueryMock.astro';
import EditMock from '../../components/mock/EditMock.astro';
import { LANDINGS } from '../../lib/landings';
import { LAUNCH_URL, RELEASES_URL } from '../../lib/site';
import {
  breadcrumbJsonLd,
  faqJsonLd,
  softwareApplicationJsonLd,
  webPageJsonLd,
} from '../../lib/seo';

export function getStaticPaths() {
  return LANDINGS.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}

const { l } = Astro.props;
const path = `/alternatives/${l.slug}`;

const jsonLd = [
  webPageJsonLd({ title: l.title, description: l.description, path }),
  breadcrumbJsonLd([
    { name: 'JustDB', path: '/' },
    { name: 'Use cases', path: '/alternatives' },
    { name: l.eyebrow, path },
  ]),
  softwareApplicationJsonLd(),
  faqJsonLd(l.faq),
];
---

<Layout title={l.title} description={l.description} jsonLd={jsonLd}>
  <Nav />

  <main>
    <!-- ── Hero ──────────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden border-b border-border">
      <div class="bg-grid pointer-events-none absolute inset-x-0 top-0 h-[520px]" aria-hidden="true"></div>
      <div
        class="pointer-events-none absolute left-1/2 top-[-12rem] h-[32rem] w-[56rem] -translate-x-1/2 rounded-full opacity-[0.14] blur-3xl"
        style="background: radial-gradient(closest-side, rgb(var(--accent)), transparent);"
        aria-hidden="true"
      ></div>

      <div class="relative mx-auto max-w-shell px-5 pb-16 pt-12 sm:px-8 sm:pt-16">
        <Breadcrumb
          trail={[
            { name: 'JustDB', path: '/' },
            { name: 'Use cases', path: '/alternatives' },
            { name: l.eyebrow },
          ]}
        />
        <div class="mt-8 max-w-3xl">
          <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted" data-reveal>{l.eyebrow}</p>
          <h1
            class="mt-3 text-[clamp(2.3rem,6vw,4rem)] font-semibold leading-[1.03] tracking-[-0.03em] text-primary"
            data-reveal
          >
            {l.h1}
          </h1>
          <p class="mt-6 max-w-2xl text-[17px] leading-relaxed text-secondary" data-reveal>{l.lead}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-reveal>
            <Button size="lg" href={LAUNCH_URL} data-fallback={RELEASES_URL} class="w-full sm:w-auto">
              Open JustDB
              <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
            </Button>
            <Button size="lg" variant="secondary" href={RELEASES_URL} external class="w-full sm:w-auto">
              Download desktop app
            </Button>
          </div>
          <p class="mt-6 font-mono text-[13px] text-muted" data-reveal>Free · No signup · Local-first</p>
        </div>

        <div class="mt-14" data-reveal>
          <AppFrame class="mx-auto max-w-[1040px]">
            <div class="h-[440px] sm:h-[480px]">
              {l.mock === 'browse' && <BrowseMock />}
              {l.mock === 'query' && <QueryMock />}
              {l.mock === 'edit' && <EditMock />}
            </div>
          </AppFrame>
        </div>
      </div>
    </section>

    <!-- ── Value props ───────────────────────────────────────────────────── -->
    <section class="border-b border-border">
      <div class="mx-auto max-w-shell px-5 py-16 sm:px-8 sm:py-24">
        <ul class="grid gap-4 sm:grid-cols-3">
          {l.points.map(({ title, body }) => (
            <li class="rounded-xl border border-border bg-bg-secondary/40 p-7" data-reveal>
              <h2 class="text-[16px] font-medium text-primary">{title}</h2>
              <p class="mt-2 text-[14px] leading-relaxed text-secondary">{body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── Capabilities ──────────────────────────────────────────────────── -->
    <section class="border-b border-border">
      <div class="mx-auto max-w-shell px-5 py-16 sm:px-8 sm:py-24">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
          <div data-reveal>
            <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted">What you get</p>
            <h2 class="mt-3 text-[clamp(1.8rem,4vw,2.6rem)] font-semibold leading-[1.1] tracking-[-0.025em] text-primary">
              Everything you need. Nothing you don't.
            </h2>
          </div>
          <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2" data-reveal>
            {l.bullets.map((item) => (
              <li class="flex gap-3 border-t border-border pt-3 text-[14px] leading-relaxed text-secondary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-accent" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ── FAQ ───────────────────────────────────────────────────────────── -->
    <section class="border-b border-border">
      <div class="mx-auto max-w-shell px-5 py-16 sm:px-8 sm:py-24">
        <div class="grid gap-12 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)]">
          <div data-reveal>
            <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted">FAQ</p>
            <h2 class="mt-3 text-[clamp(1.8rem,4vw,2.6rem)] font-semibold leading-[1.08] tracking-[-0.025em] text-primary">
              Common questions.
            </h2>
          </div>
          <div class="divide-y divide-border border-y border-border" data-reveal>
            {l.faq.map(({ q, a }) => (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[15px] font-medium text-primary transition-colors hover:text-accent [&::-webkit-details-marker]:hidden">
                  {q}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="shrink-0 text-muted transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </summary>
                <p class="max-w-2xl pb-6 text-[14px] leading-relaxed text-secondary">{a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <CtaBand class="border-t-0" />
  <Footer />
  <PageScripts />
</Layout>
