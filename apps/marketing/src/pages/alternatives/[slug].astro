---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageScripts from '../../components/PageScripts.astro';
import { LANDINGS } from '../../lib/landings';
import { LAUNCH_URL, RELEASES_URL } from '../../lib/site';
import {
  breadcrumbJsonLd,
  faqJsonLd,
  softwareApplicationJsonLd,
  webPageJsonLd,
} from '../../lib/seo';

export function getStaticPaths() {
  return LANDINGS.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}

const { l } = Astro.props;
const path = `/alternatives/${l.slug}`;

const jsonLd = [
  webPageJsonLd({ title: l.title, description: l.description, path }),
  breadcrumbJsonLd([
    { name: 'JustDB', path: '/' },
    { name: 'Use cases', path: '/alternatives' },
    { name: l.eyebrow, path },
  ]),
  softwareApplicationJsonLd(),
  faqJsonLd(l.faq),
];
---

<Layout title={l.title} description={l.description} jsonLd={jsonLd}>
  <Nav />

  <main class="use-case">
    <section class="hero shell">
      <Breadcrumb trail={[{ name: 'JustDB', path: '/' }, { name: 'Use cases', path: '/alternatives' }, { name: l.eyebrow }]} />
      <div class="hero-copy">
        <h1>{l.h1}</h1>
        <p class="lead">{l.lead}</p>
        <div class="actions">
          <a class="button" href={RELEASES_URL}>Download JustDB</a>
          <a class="button secondary" href={LAUNCH_URL} title="Launch JustDB — requires the desktop app to be installed">Launch installed app ↗</a>
        </div>
        <p class="availability">Free · macOS & Windows · No account needed</p>
      </div>
      <figure class="workspace">
        <img src="/features/workspace-sharp-2400.webp" srcset="/features/workspace-sharp-1200.webp 1200w, /features/workspace-sharp-2400.webp 2400w" sizes="(max-width: 1248px) calc(100vw - 48px), 1200px" width="2400" height="1505" alt="The JustDB workspace showing sample SQLite orders, column types, and table filters." fetchpriority="high" />
        <figcaption>The JustDB workspace, shown with a sample SQLite database.</figcaption>
      </figure>
    </section>
    <section class="shell benefits" aria-label="Why JustDB">
      <div class="cards">
        {l.points.map(({ title, body }) => (
          <article class="card">
            <h2>{title}</h2><p>{body}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="shell split">
      <div><h2>Keep your data<br />within reach.</h2></div>
      <ul class="capabilities">{l.bullets.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
    </section>
    <section class="shell split">
      <div><h2>Common questions.</h2></div>
      <div class="questions">{l.faq.map(({ q, a }) => (
        <details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>
      ))}</div>
    </section>
    <section class="shell closing">
      <h2>Get straight to your data.</h2>
      <p>Download JustDB and open your first connection.</p>
      <div class="actions"><a class="button" href={RELEASES_URL}>Download JustDB</a><a href="/blog">Explore the blog →</a></div>
    </section>
  </main>

  <Footer />
  <PageScripts />
</Layout>

<style>
  .use-case { color:rgb(var(--text-primary)); background:rgb(var(--bg)); }
  .shell { max-width:1248px; width:100%; margin:auto; padding-inline:24px; }
  .hero { padding-top:32px; }
  .hero-copy { max-width:820px; margin:64px auto 56px; text-align:center; }
  .eyebrow,.frame-label { font-size:11px; letter-spacing:.08em; color:rgb(var(--text-muted)); }
  h1 { font-size:clamp(40px,6vw,68px); font-weight:400; line-height:1.08; margin-top:24px; }
  .lead { max-width:650px; margin:28px auto 0; font-size:17px; line-height:1.7; color:rgb(var(--text-secondary)); }
  .actions { display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:16px; margin-top:30px; font-size:14px; }
  .button { display:inline-flex; align-items:center; justify-content:center; padding:10px 18px; min-height:40px; border:1px solid rgb(var(--accent)); border-radius:6px; background:rgb(var(--accent)); color:rgb(var(--accent-text)); font-size:14px; transition:background-color 150ms; }
  .button:hover { background:rgb(var(--accent-hover)); }
  .button.secondary { background:rgb(var(--bg-elevated)); color:rgb(var(--text-primary)); border-color:rgb(var(--border)); }
  .availability { font-size:12px; margin-top:20px; color:rgb(var(--text-muted)); }
  .workspace { border:1px solid rgb(var(--border)); border-radius:8px; overflow:hidden; }
  .frame-label { padding:16px 20px; display:flex; justify-content:space-between; border-bottom:1px solid rgb(var(--border)); }
  .workspace img { display:block; width:100%; height:auto; filter:grayscale(1); outline:1px solid rgb(255 255 255 / .1); outline-offset:-1px; }
  :global([data-theme="light"]) .workspace img { outline-color:rgb(0 0 0 / .1); }
  figcaption { border-top:1px solid rgb(var(--border)); padding:16px 20px; font-size:12px; color:rgb(var(--text-muted)); }
  .benefits { margin-top:64px; }
  .cards { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; }
  .card { padding:32px; border:1px solid rgb(var(--border)); border-radius:8px; background:linear-gradient(135deg,rgb(var(--text-primary) / .06),transparent 65%),rgb(var(--bg-secondary) / .55); backdrop-filter:blur(18px); box-shadow:inset 0 1px 0 rgb(var(--text-primary) / .07); }
  .card h2 { font-size:25px; font-weight:400; line-height:1.25; margin:0 0 16px; }
  .card>p:last-child,.closing>p:not(.eyebrow) { font-size:15px; line-height:1.7; color:rgb(var(--text-secondary)); }
  .split { display:grid; grid-template-columns:1fr 1.3fr; gap:64px; padding-block:72px; border-bottom:1px solid rgb(var(--border)); }
  .split h2,.closing h2 { font-size:clamp(28px,4vw,42px); line-height:1.15; font-weight:400; margin-top:20px; }
  .capabilities li { display:flex; gap:16px; border-top:1px solid rgb(var(--border)); padding-block:16px; color:rgb(var(--text-secondary)); font-size:15px; line-height:1.6; }
  .questions details { border-top:1px solid rgb(var(--border)); }
  summary { cursor:pointer; display:flex; align-items:center; justify-content:space-between; gap:24px; padding-block:20px; font-size:15px; list-style:none; }
  summary::-webkit-details-marker { display:none; }
  summary span { font-size:22px; color:rgb(var(--text-muted)); }
  details[open] summary span { transform:rotate(45deg); }
  details p { padding-bottom:24px; color:rgb(var(--text-secondary)); font-size:15px; line-height:1.7; }
  .closing { text-align:center; padding-block:80px; }
  .closing>p:not(.eyebrow) { margin-top:24px; }
  @media(max-width:760px) { .cards,.split { grid-template-columns:1fr; }.split { gap:32px; padding-block:48px; }.hero-copy { margin-top:40px; }.card { padding:24px; }.frame-label span:last-child { display:none; } }
  @media(max-width:480px) { .shell { padding-inline:16px; } }
  @media(prefers-reduced-transparency:reduce) { .card { background:rgb(var(--bg-secondary)); backdrop-filter:none; } }
</style>
