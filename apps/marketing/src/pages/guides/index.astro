---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageScripts from '../../components/PageScripts.astro';
import { GUIDES } from '../../lib/guides';
import { breadcrumbJsonLd, webPageJsonLd } from '../../lib/seo';

const title = 'JustDB Guides — practical database how-tos';
const description =
  'Short, practical guides for working with PostgreSQL, SQLite and Turso — view SQLite tables locally, edit Postgres cells inline, connect to a database in Docker, and more.';
const path = '/guides';

const jsonLd = [
  webPageJsonLd({ title, description, path }),
  breadcrumbJsonLd([
    { name: 'JustDB', path: '/' },
    { name: 'Guides', path },
  ]),
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Nav />

  <main>
    <section class="relative overflow-hidden border-b border-border">
      <div class="bg-grid pointer-events-none absolute inset-x-0 top-0 h-[360px]" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-shell px-5 pb-14 pt-12 sm:px-8 sm:pt-16">
        <Breadcrumb trail={[{ name: 'JustDB', path: '/' }, { name: 'Guides' }]} />
        <div class="mt-8 max-w-3xl">
          <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted" data-reveal>Guides</p>
          <h1
            class="mt-3 text-[clamp(2.2rem,5.4vw,3.6rem)] font-semibold leading-[1.05] tracking-[-0.03em] text-primary"
            data-reveal
          >
            Practical database how-tos.
          </h1>
          <p class="mt-6 max-w-2xl text-[17px] leading-relaxed text-secondary" data-reveal>
            Short, no-fluff answers to the everyday questions that come up while
            working with PostgreSQL, SQLite and Turso — each one you can act on in
            a couple of minutes.
          </p>
        </div>
      </div>
    </section>

    <section>
      <div class="mx-auto max-w-shell px-5 py-16 sm:px-8 sm:py-24">
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {GUIDES.map((g) => (
            <li data-reveal>
              <a
                href={`/guides/${g.slug}`}
                class="group flex h-full flex-col rounded-xl border border-border bg-bg-secondary/40 p-7 transition-[transform,border-color] duration-300 hover:-translate-y-1 hover:border-border-strong"
              >
                <p class="font-mono text-[12px] text-muted">{g.tag}</p>
                <h2 class="mt-3 text-[17px] font-semibold leading-snug tracking-tight text-primary">{g.title}</h2>
                <p class="mt-3 flex-1 text-[14px] leading-relaxed text-secondary">{g.summary}</p>
                <span class="mt-5 inline-flex items-center gap-1.5 text-[14px] font-medium text-accent">
                  Read guide
                  <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <CtaBand />
  <Footer />
  <PageScripts />
</Layout>
