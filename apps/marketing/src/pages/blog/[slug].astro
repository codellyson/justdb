---
import { marked } from 'marked';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { GUIDES } from '../../lib/guides';

export function getStaticPaths() {
  return GUIDES.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const html = marked.parse(post.body.trim(), { gfm: true, breaks: false });
const more = GUIDES.filter((entry) => entry.slug !== post.slug);
---
<BlogLayout title={`${post.title} — JustDB Blog`} description={post.description} article headline={post.title}>
  <article class="post">
    <a class="back" href="/blog">← All articles</a>
    <p class="meta">{post.tag}</p>
    <h1>{post.title}</h1>
    <p class="lead">{post.description}</p>
    <div class="guide-body" set:html={html} />
    <section class="end">
      <h2>Keep reading</h2>
      <ul>
        <li><a href="/blog/inspect-records-without-losing-context">Inspect a record without losing your place</a></li>
        {more.map((entry) => <li><a href={`/blog/${entry.slug}`}>{entry.title}</a></li>)}
      </ul>
    </section>
  </article>
</BlogLayout>
<style is:global>

  /* Markdown rendered into .guide-body — a small typographic shell that matches
     the site palette without pulling in a full prose plugin. */
  .guide-body { @apply text-[15px] leading-relaxed text-secondary; }
  .guide-body > * + * { @apply mt-4; }
  .guide-body h2 {
    @apply mt-12 mb-1 text-[22px] font-semibold tracking-tight text-primary;
  }
  .guide-body h3 {
    @apply mt-8 text-[17px] font-medium text-primary;
  }
  .guide-body p { @apply text-secondary; }
  .guide-body a {
    @apply text-primary underline decoration-border-strong underline-offset-2 transition-colors hover:text-accent hover:decoration-accent;
  }
  .guide-body strong { @apply font-semibold text-primary; }
  .guide-body ol { @apply mt-4 space-y-2 pl-5 list-decimal marker:text-muted; }
  .guide-body ul { @apply mt-4 space-y-2 pl-5 list-disc marker:text-muted; }
  .guide-body li { @apply pl-1 text-secondary; }
  .guide-body li::marker { @apply text-muted; }
  .guide-body code {
    @apply rounded bg-bg-secondary px-1.5 py-0.5 font-mono text-[13px] text-primary;
  }
  .guide-body pre {
    @apply mt-4 overflow-x-auto rounded-xl border border-border bg-bg-secondary/60 p-4;
  }
  .guide-body pre code {
    @apply bg-transparent p-0 text-[13px] leading-relaxed text-secondary;
  }

  .journal .guide-body { margin-top:36px; }
  .journal .guide-body ul { list-style:disc; }
  .journal .guide-body a, .journal .end a { text-decoration:underline; text-underline-offset:3px; }
</style>
