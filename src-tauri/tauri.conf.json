{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "JustDB",
  "version": "0.2.4",
  "identifier": "com.kreativekorna.justdb",
  "build": {
    "frontendDist": "../apps/web/dist",
    "devUrl": "http://localhost:3030",
    "beforeDevCommand": "pnpm --filter @justdb/web dev",
    "beforeBuildCommand": "pnpm --filter @justdb/web build"
  },
  "app": {
    "windows": [
      {
        "title": "JustDB",
        "url": "/connections",
        "width": 1600,
        "height": 1000,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#121212"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/codellyson/justdb/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5MTVEQkJDNDExRTk5NjIKUldSaW1SNUJ2TnNWS1hwTVFXVDMyUW9LS0FSQVV6ays5anVKWEIvU3dYZ3NtejZYY2tNOGhnVG8K"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["justdb"]
      }
    }
  }
}
